# Go API
DB_URL=postgres://USER:PASSWORD@localhost:5432/pollutrace?sslmode=disable
PORT=8080
# Frontend origin allowed to call the API (omit to send no CORS header)
CORS_ALLOW_ORIGIN=http://localhost:3000
# Python inference service (pipeline/serve.py). Leave empty to disable /api/predict.
INFERENCE_URL=http://127.0.0.1:8100

# Free station readings via OpenAQ. Keep key server-side and out of git/ZIPs.
OPENAQ_API_KEY=
# Optional: run without Postgres (historical pages then show unavailable).
LIVE_ONLY=false
# Only reviewed stations are enabled by default. Do not guess station IDs.
OPENAQ_STATIONS={"Delhi":8118,"Mumbai":8039}
